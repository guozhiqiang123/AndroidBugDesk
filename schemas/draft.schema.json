{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        { "type": "null" }
      ]
    },
    "jenkinsPackageUrl": { "type": "string", "maxLength": 50000 },
    "title": { "type": "string", "maxLength": 50000 },
    "bugPage": { "type": "string", "maxLength": 50000 },
    "kind": {
      "type": "string",
      "enum": [
        "功能",
        "UI",
        "多语言",
        "动态过程",
        "崩溃",
        "ANR",
        "性能",
        "网络",
        "数据"
      ]
    },
    "workitemTypeId": { "type": "string", "maxLength": 50000 },
    "assignedTo": { "type": "string", "maxLength": 50000 },
    "sprint": { "type": "string", "maxLength": 50000 },
    "versions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 50000 }
    },
    "app": {
      "type": "object",
      "properties": {
        "packageName": { "type": "string", "maxLength": 50000 },
        "versionName": { "type": "string", "maxLength": 50000 },
        "versionCode": { "type": "string", "maxLength": 50000 }
      },
      "required": ["packageName", "versionName", "versionCode"],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "maxLength": 50000 },
        "androidVersion": { "type": "string", "maxLength": 50000 },
        "totalMemKb": { "type": "string", "maxLength": 50000 },
        "availableMemKb": { "type": "string", "maxLength": 50000 },
        "resolution": { "type": "string", "maxLength": 50000 },
        "density": { "type": "string", "maxLength": 50000 }
      },
      "required": [
        "model",
        "androidVersion",
        "totalMemKb",
        "availableMemKb",
        "resolution",
        "density"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "occurredAt": { "type": "string", "maxLength": 50000 },
        "originalAt": { "type": "string", "maxLength": 50000 },
        "source": { "type": "string", "enum": ["auto", "manual"] },
        "sourceNote": { "type": "string", "maxLength": 50000 }
      },
      "required": ["occurredAt", "originalAt", "source", "sourceNote"],
      "additionalProperties": false
    },
    "preconditions": { "type": "string", "maxLength": 50000 },
    "steps": { "type": "string", "maxLength": 50000 },
    "expected": { "type": "string", "maxLength": 50000 },
    "actual": { "type": "string", "maxLength": 50000 },
    "frequency": {
      "type": "object",
      "properties": {
        "firstDiscovery": { "type": "boolean" },
        "attempts": { "type": "string", "maxLength": 50000 },
        "occurrences": { "type": "string", "maxLength": 50000 }
      },
      "required": ["firstDiscovery", "attempts", "occurrences"],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "maxLength": 50000 },
        "type": { "type": "string", "maxLength": 50000 },
        "error": { "type": "string", "maxLength": 50000 },
        "collectionStatus": { "type": "string", "maxLength": 50000 }
      },
      "required": ["operation", "type", "error", "collectionStatus"],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50000 },
        "count": { "type": "string", "maxLength": 50000 },
        "source": { "type": "string", "maxLength": 50000 }
      },
      "required": ["type", "count", "source"],
      "additionalProperties": false
    },
    "customFields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 50000 },
          { "type": "array", "items": { "type": "string", "maxLength": 50000 } }
        ]
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["collected", "failed", "manual", "not_applicable"]
          },
          "at": { "type": "string", "maxLength": 50000 },
          "detail": { "type": "string", "maxLength": 50000 }
        },
        "required": ["status", "at", "detail"],
        "additionalProperties": false
      }
    },
    "collectionErrors": {
      "type": "array",
      "items": { "type": "string", "maxLength": 50000 }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string", "maxLength": 50000 },
          "path": { "type": "string", "maxLength": 50000 },
          "mime": { "type": "string", "maxLength": 50000 },
          "size": { "type": "number", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "role": {
            "type": "string",
            "enum": ["log", "image", "video", "report", "sample"]
          },
          "source": { "type": "string", "maxLength": 50000 },
          "coverageStart": {
            "default": "",
            "type": "string",
            "maxLength": 50000
          },
          "coverageEnd": {
            "default": "",
            "type": "string",
            "maxLength": 50000
          },
          "confirmed": { "type": "boolean" },
          "derivedFrom": { "default": null, "type": ["string", "null"] }
        },
        "required": [
          "id",
          "name",
          "path",
          "mime",
          "size",
          "sha256",
          "role",
          "source",
          "coverageStart",
          "coverageEnd",
          "confirmed",
          "derivedFrom"
        ],
        "additionalProperties": false
      }
    },
    "previewConfirmed": { "type": "boolean" },
    "createdAt": { "type": "string", "maxLength": 50000 },
    "updatedAt": { "type": "string", "maxLength": 50000 }
  },
  "required": [
    "id",
    "sessionId",
    "jenkinsPackageUrl",
    "title",
    "kind",
    "workitemTypeId",
    "assignedTo",
    "sprint",
    "versions",
    "app",
    "device",
    "event",
    "preconditions",
    "steps",
    "expected",
    "actual",
    "frequency",
    "network",
    "data",
    "customFields",
    "sources",
    "collectionErrors",
    "attachments",
    "previewConfirmed",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
